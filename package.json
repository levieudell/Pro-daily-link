{
  "name": "pro-daily-link",
  "version": "0.2.0",
  "private": true,
  "description": "Construction field production SaaS MVP",
  "dependencies": {
    "@sentry/node": "^10.0.0",
    "pg": "^8.16.3",
    "stripe": "22.6.2",
    "@heycatch/sdk": "^0.8.3"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/run-checks.cjs check",
    "test": "node scripts/run-checks.cjs test",
    "migrate:tenant:preview": "node database/migrate-json.js",
    "migrate:tenant:apply": "node database/migrate-json.js --apply",
    "migrate:transactional:preview": "node database/migrate-transactional.js",
    "migrate:transactional:apply": "node database/migrate-transactional.js --apply",
    "launch:check": "node database/launch-readiness.js",
    "backup:restore-drill": "node database/restore-drill.js",
    "backup:audit": "node database/backup-audit.js",
    "backup:portable": "node database/portable-backup.js",
    "services:verify": "node scripts/service-smoke-test.js",
    "services:verify-email": "node scripts/service-smoke-test.js --send-email",
    "account:commercial": "node database/set-commercial-account.js",
    "account:temp-password": "node database/set-temp-password.js",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File database/bootstrap-postgres.ps1",
    "db:stop": "docker compose stop postgres",
    "db:status": "docker compose ps postgres",
    "test:concurrency": "node database/concurrency-test.js",
    "test:load": "node scripts/load-test.js",
    "security:scan": "node scripts/security-scan.js",
    "monitor:verify": "node scripts/verify-monitoring.js",
    "assistant:ledger:check": "node database/assistant-budget-readiness.js",
    "assistant:ledger:initialize": "node database/assistant-budget-readiness.js --apply",
    "test:roles:production:native": "node database/roles-snapshot-postgres.test.js",
    "test:roles:production:browser": "node roles-production-browser.test.js",
    "test:roles:platform:native": "node database/platform-snapshot-postgres.test.js",
    "test:roles:platform:http": "node roles-platform-multiworker-http.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "parse5": "7.3.0"
  }
}
