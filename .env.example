# Copy to .env only for local development. Never commit the real password.
PDL_POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://pro_daily_link:replace-with-a-long-random-password@127.0.0.1:5432/pro_daily_link
PDL_SUPABASE_ENABLED=0

# Use only test-mode credentials until billing acceptance tests pass.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Create a Node project in Sentry, then add its hosted Sentry DSN privately.
# Error events are scrubbed server-side. Performance traces are disabled.
SENTRY_DSN=

# Staging web service (PDL_STAGING=1). Do not set Supabase, Stripe, Resend, or IndexNow there.
# Required: PDL_STAGING=1, PDL_STAGING_OWNER_PASSWORD, PDL_STAGING_FIELD_PASSWORD
# Optional notes parsing: OPENAI_API_KEY (model override OPENAI_MODEL, default gpt-5.4-mini)
# PDL_STAGING=1
# PDL_STAGING_OWNER_PASSWORD=
# PDL_STAGING_FIELD_PASSWORD=
# OPENAI_API_KEY=
