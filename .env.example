# Copy to .env only for local development. Never commit the real password.
PDL_POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://pro_daily_link:replace-with-a-long-random-password@127.0.0.1:5432/pro_daily_link
PDL_SUPABASE_ENABLED=0

# Use only test-mode credentials until billing acceptance tests pass.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Search indexing. See docs/SEARCH-INDEXING.md.
# IndexNow key served at /<key>.txt. Blank uses the documented default f4e96dc71c5a80a0538d211e687dfaaa.
INDEXNOW_KEY=
# Optional HTML verification tags. Prefer a DNS TXT record for a Google Search Console Domain property, then import that property into Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
