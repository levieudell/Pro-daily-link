# Copy to .env only for local development. Never commit the real password.
PDL_POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://pro_daily_link:replace-with-a-long-random-password@127.0.0.1:5432/pro_daily_link
PDL_SUPABASE_ENABLED=0

# Use only test-mode credentials until billing acceptance tests pass.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Non-secret labels shared by Render and the independent verifier. Change the
# applicable label whenever the corresponding runtime credential rotates.
PDL_STRIPE_RUNTIME_KEY_VERSION=
PDL_STRIPE_WEBHOOK_SECRET_VERSION=
# Dedicated Customer Portal configurations; see docs/STRIPE-BILLING-OPERATIONS.md.
# Standard enables exactly the current six standard prices. Founder disables plan updates.
STRIPE_PORTAL_CONFIG_STANDARD=
STRIPE_PORTAL_CONFIG_FOUNDER=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_FOUNDER_STARTER=
STRIPE_PRICE_FOUNDER_STARTER_ANNUAL=
STRIPE_PRICE_FOUNDER_GROWTH=
STRIPE_PRICE_FOUNDER_GROWTH_ANNUAL=
STRIPE_PRICE_FOUNDER_PRO=
STRIPE_PRICE_FOUNDER_PRO_ANNUAL=
STRIPE_PRICE_ASSISTED_SETUP=
STRIPE_PRODUCT_STARTER=
STRIPE_PRODUCT_GROWTH=
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_FOUNDER_STARTER=
STRIPE_PRODUCT_FOUNDER_GROWTH=
STRIPE_PRODUCT_FOUNDER_PRO=
STRIPE_PRODUCT_ASSISTED_SETUP=

# Provider readiness is published only by the independent active monitor.
# Render receives the public key. Keep the private key off Render and out of .env.
PDL_PRODUCTION_SUPABASE_PROJECT_REF=
PDL_PROVIDER_ATTESTATION_PUBLIC_KEY=
# Optional 50-10000 ms deadline for the complete operational readiness snapshot (default 5000).
# PDL_OPERATIONAL_HEALTH_TIMEOUT_MS=5000
# Optional 50-120000 ms deadline for each tenant backup upload/download verification (default 60000).
# PDL_BACKUP_VERIFICATION_TIMEOUT_MS=60000
# Independent monitor secret store only:
# PDL_PROVIDER_ATTESTATION_PRIVATE_KEY=
# PDL_MONITOR_EMAIL_TO=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Create a Node project in Sentry, then add its hosted Sentry DSN privately.
# Error events are scrubbed server-side. Performance traces are disabled.
SENTRY_DSN=
PDL_SENTRY_RUNTIME_DSN_VERSION=

RESEND_API_KEY=
RESEND_FROM=Pro Daily Link <support@prodailylink.com>
RESEND_REPLY_TO=support@prodailylink.com
PDL_RESEND_RUNTIME_KEY_VERSION=

# Staging web service (PDL_STAGING=1). Do not set Supabase, Stripe, Resend, or IndexNow there.
# Required: PDL_STAGING=1, PDL_STAGING_OWNER_PASSWORD, PDL_STAGING_FIELD_PASSWORD
# Optional office daily login: PDL_STAGING_OFFICE_PASSWORD (no default; unset skips the user)
# Optional notes parsing: OPENAI_API_KEY (model override OPENAI_MODEL, default gpt-5.4-mini)
# PDL_STAGING=1
# PDL_STAGING_OWNER_PASSWORD=
# PDL_STAGING_FIELD_PASSWORD=
# PDL_STAGING_OFFICE_PASSWORD=
# OPENAI_API_KEY=
